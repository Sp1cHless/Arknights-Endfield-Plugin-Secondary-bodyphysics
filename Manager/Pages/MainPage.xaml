<Page x:Class="SecondaryMotion.Manager.Pages.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="{DynamicResource M_main}"
      Loaded="OnLoaded"
      Unloaded="OnUnloaded">

    <Page.Resources>
        <SolidColorBrush x:Key="CardBorderBrush" Color="#E4E7EB" />
        <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="MutedBrush" Color="#7A7A7A" />
        <SolidColorBrush x:Key="SoftFillBrush" Color="#F4F6F8" />

        <Style x:Key="CardStyle" TargetType="{x:Type Border}">
            <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="18" />
            <Setter Property="Margin" Value="0,12,0,0" />
        </Style>

        <Style x:Key="SectionHintStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="10,1,0,0" />
        </Style>

        <Style x:Key="AdvancedParamTitle" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#222222" />
        </Style>

        <Style x:Key="AdvancedParamHint" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="9" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,2,8,0" />
        </Style>

        <Style x:Key="StatusValueStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="#222222" />
        </Style>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="28,22,32,28"
                    MaxWidth="720"
                    HorizontalAlignment="Left">

            <!-- Page heading -->
            <TextBlock Text="{DynamicResource M_shaking_and_jumping_breast}"
                       Style="{StaticResource PageTitle}" />
            <TextBlock Text="{Binding DataDir}"
                       Foreground="{StaticResource MutedBrush}"
                       FontSize="10"
                       Margin="0,3,0,0"
                       TextWrapping="Wrap" />

            <!-- Global switch -->
            <CheckBox Content="{DynamicResource M_plugin_active_global_switch_off_clea}"
                      Foreground="Black"
                      IsChecked="{Binding PluginActive}"
                      Margin="0,14,0,0" />

            <!-- Current status -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="{DynamicResource M_current_status}"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Margin="0,0,0,10" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition MinHeight="30" />
                            <RowDefinition MinHeight="30" />
                            <RowDefinition MinHeight="30" />
                            <RowDefinition MinHeight="30" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0"
                                   Text="{DynamicResource M_game}"
                                   Style="{StaticResource FieldLabel}" />
                        <Border Grid.Row="0" Grid.Column="1"
                                Background="{StaticResource SoftFillBrush}"
                                CornerRadius="5"
                                Padding="8,4"
                                Margin="0,2">
                            <TextBlock Text="{Binding GameState}"
                                       Style="{StaticResource StatusValueStyle}" />
                        </Border>

                        <TextBlock Grid.Row="1" Grid.Column="0"
                                   Text="{DynamicResource M_plugin}"
                                   Style="{StaticResource FieldLabel}" />
                        <Border Grid.Row="1" Grid.Column="1"
                                Background="{StaticResource SoftFillBrush}"
                                CornerRadius="5"
                                Padding="8,4"
                                Margin="0,2">
                            <TextBlock Text="{Binding PluginState}"
                                       Style="{StaticResource StatusValueStyle}" />
                        </Border>

                        <TextBlock Grid.Row="2" Grid.Column="0"
                                   Text="{DynamicResource M_character}"
                                   Style="{StaticResource FieldLabel}" />
                        <Border Grid.Row="2" Grid.Column="1"
                                Background="{StaticResource SoftFillBrush}"
                                CornerRadius="5"
                                Padding="8,4"
                                Margin="0,2">
                            <TextBlock Text="{Binding Character}"
                                       Style="{StaticResource StatusValueStyle}" />
                        </Border>

                        <TextBlock Grid.Row="3" Grid.Column="0"
                                   Text="{DynamicResource M_preset}"
                                   Style="{StaticResource FieldLabel}" />
                        <Border Grid.Row="3" Grid.Column="1"
                                Background="{StaticResource SoftFillBrush}"
                                CornerRadius="5"
                                Padding="8,4"
                                Margin="0,2">
                            <TextBlock Text="{Binding Preset}"
                                       Style="{StaticResource StatusValueStyle}" />
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Character motion controls -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <CheckBox Content="{DynamicResource M_enable_motion_for_this_character}"
                              Foreground="Black"
                              IsEnabled="{Binding HasCurrent}"
                              IsChecked="{Binding Current.Enabled}" />

                    <Border Background="#F2F6FA"
                            BorderBrush="#DCE6EF"
                            BorderThickness="1"
                            CornerRadius="5"
                            Padding="10,7"
                            Margin="0,10,0,0"
                            Visibility="{Binding HasCurrent, Converter={StaticResource InverseBoolToVisibility}}">
                        <TextBlock Text="{DynamicResource M_start_the_game_to_edit_the_current_c}"
                                   Foreground="#65717C"
                                   FontSize="11" />
                    </Border>

                    <Grid Margin="0,12,0,0"
                          IsEnabled="{Binding HasCurrent}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="240" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="{DynamicResource M_mode}"
                                   Style="{StaticResource FieldLabel}" />
                        <ComboBox Grid.Column="1"
                                  Height="30"
                                  SelectedIndex="{Binding Current.ModeIndex}">
                            <ComboBoxItem Content="{DynamicResource M_original_off}" />
                            <ComboBoxItem Content="{DynamicResource M_synthetic}" />
                            <ComboBoxItem Content="{DynamicResource M_amplify_native}" />
                        </ComboBox>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Gait -->
            <Border Style="{StaticResource CardStyle}"
                    IsEnabled="{Binding HasCurrent}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="{DynamicResource M_gait}"
                                   Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="{DynamicResource M_edit_motion_data_please_adjust_accor}"
                                   Style="{StaticResource SectionHintStyle}" />
                    </StackPanel>

                    <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Disabled">
                    <Grid HorizontalAlignment="Left">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="70" />
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="55" />
                            <ColumnDefinition Width="55" />
                            <ColumnDefinition Width="64" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="28" />
                            <RowDefinition Height="40" />
                            <RowDefinition Height="40" />
                            <RowDefinition Height="40" />
                            <RowDefinition Height="40" />
</Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="1"
                                   Text="{DynamicResource M_up_degree}"
                                   Foreground="{StaticResource MutedBrush}"
                                   FontSize="11"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                        <TextBlock Grid.Row="0" Grid.Column="2"
                                   Text="{DynamicResource M_down_degree}"
                                   Foreground="{StaticResource MutedBrush}"
                                   FontSize="11"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                        <TextBlock Grid.Row="0" Grid.Column="3"
                                   Text="{DynamicResource M_frequency_hz}"
                                   Foreground="{StaticResource MutedBrush}"
                                   FontSize="11"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                        <TextBlock Grid.Row="0" Grid.Column="4"
                                   Text="{DynamicResource M_phase_offset_deg}"
                                   Foreground="{StaticResource MutedBrush}"
                                   FontSize="11"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                        <TextBlock Grid.Row="0" Grid.Column="5"
                                   Text="{DynamicResource M_phase_align}"
                                   Foreground="{StaticResource MutedBrush}"
                                   FontSize="11"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                        <TextBlock Grid.Row="0" Grid.Column="6"
                                   Text="{DynamicResource M_auto_freq}"
                                   Foreground="{StaticResource MutedBrush}"
                                   FontSize="11"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                        <TextBlock Grid.Row="0" Grid.Column="7"
                                   Text="{DynamicResource M_freq_dev_threshold}"
                                   Foreground="{StaticResource MutedBrush}"
                                   FontSize="11"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />

                        <TextBlock Grid.Row="1" Grid.Column="0"
                                   Text="{DynamicResource M_walk}"
                                   Style="{StaticResource FieldLabel}" />
                        <TextBox Grid.Row="1" Grid.Column="1"
                                 Height="30" Margin="4"
                                 VerticalContentAlignment="Center"
                                 TextAlignment="Right"
                                 Text="{Binding Current.WalkAmp, Mode=TwoWay, Converter={StaticResource DoubleToText}}" />
                        <TextBox Grid.Row="1" Grid.Column="2"
                                 Height="30" Margin="4"
                                 VerticalContentAlignment="Center"
                                 TextAlignment="Right"
                                 Text="{Binding Current.WalkDown, Mode=TwoWay, Converter={StaticResource DoubleToText}}" />
                        <TextBox Grid.Row="1" Grid.Column="3"
                                 Height="30" Margin="4"
                                 VerticalContentAlignment="Center"
                                 TextAlignment="Right"
                                 Text="{Binding Current.WalkFreq, Mode=TwoWay, Converter={StaticResource DoubleToText}}" />
                        <TextBox Grid.Row="1" Grid.Column="4"
                                 Height="30" Margin="4"
                                 VerticalContentAlignment="Center"
                                 TextAlignment="Right"
                                 Text="{Binding Current.WalkPhaseOffset, Mode=TwoWay, Converter={StaticResource DoubleToText}}" />
                        <CheckBox Grid.Row="1" Grid.Column="5"
                                  IsChecked="{Binding Current.WalkPhaseAlign, Mode=TwoWay}"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center" />
                        <CheckBox Grid.Row="1" Grid.Column="6"
                                  IsChecked="{Binding Current.WalkAutoFreq, Mode=TwoWay}"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center" />
                        <TextBox Grid.Row="1" Grid.Column="7"
                                 Height="30" Margin="4"
                                 VerticalContentAlignment="Center"
                                 TextAlignment="Right"
                                 Text="{Binding Current.WalkFreqDevThreshold, Mode=TwoWay, Converter={StaticResource DoubleToText}}" />

                        <TextBlock Grid.Row="2" Grid.Column="0"
                                   Text="{DynamicResource M_run}"
                                   Style="{StaticResource FieldLabel}" />
                        <TextBox Grid.Row="2" Grid.Column="1"
                                 Height="30" Margin="4"
                                 VerticalContentAlignment="Center"
                                 TextAlignment="Right"
                                 Text="{Binding Current.RunAmp, Mode=TwoWay, Converter={StaticResource DoubleToText}}" />
                        <TextBox Grid.Row="2" Grid.Column="2"
                                 Height="30" Margin="4"
                                 VerticalContentAlignment="Center"
                                 TextAlignment="Right"
                                 Text="{Binding Current.RunDown, Mode=TwoWay, Converter={StaticResource DoubleToText}}" />
                        <TextBox Grid.Row="2" Grid.Column="3"
                                 Height="30" Margin="4"
                                 VerticalContentAlignment="Center"
                                 TextAlignment="Right"
                                 Text="{Binding Current.RunFreq, Mode=TwoWay, Converter={StaticResource DoubleToText}}" />
                        <TextBox Grid.Row="2" Grid.Column="4"
                                 Height="30" Margin="4"
                                 VerticalContentAlignment="Center"
                                 TextAlignment="Right"
                                 Text="{Binding Current.RunPhaseOffset, Mode=TwoWay, Converter={StaticResource DoubleToText}}" />
                        <CheckBox Grid.Row="2" Grid.Column="5"
                                  IsChecked="{Binding Current.RunPhaseAlign, Mode=TwoWay}"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center" />
                        <CheckBox Grid.Row="2" Grid.Column="6"
                                  IsChecked="{Binding Current.RunAutoFreq, Mode=TwoWay}"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center" />
                        <TextBox Grid.Row="2" Grid.Column="7"
                                 Height="30" Margin="4"
                                 VerticalContentAlignment="Center"
                                 TextAlignment="Right"
                                 Text="{Binding Current.RunFreqDevThreshold, Mode=TwoWay, Converter={StaticResource DoubleToText}}" />

                        <TextBlock Grid.Row="3" Grid.Column="0"
                                   Text="{DynamicResource M_sprint}"
                                   Style="{StaticResource FieldLabel}" />
                        <TextBox Grid.Row="3" Grid.Column="1"
                                 Height="30" Margin="4"
                                 VerticalContentAlignment="Center"
                                 TextAlignment="Right"
                                 Text="{Binding Current.SprintAmp, Mode=TwoWay, Converter={StaticResource DoubleToText}}" />
                        <TextBox Grid.Row="3" Grid.Column="2"
                                 Height="30" Margin="4"
                                 VerticalContentAlignment="Center"
                                 TextAlignment="Right"
                                 Text="{Binding Current.SprintDown, Mode=TwoWay, Converter={StaticResource DoubleToText}}" />
                        <TextBox Grid.Row="3" Grid.Column="3"
                                 Height="30" Margin="4"
                                 VerticalContentAlignment="Center"
                                 TextAlignment="Right"
                                 Text="{Binding Current.SprintFreq, Mode=TwoWay, Converter={StaticResource DoubleToText}}" />
                        <TextBox Grid.Row="3" Grid.Column="4"
                                 Height="30" Margin="4"
                                 VerticalContentAlignment="Center"
                                 TextAlignment="Right"
                                 Text="{Binding Current.SprintPhaseOffset, Mode=TwoWay, Converter={StaticResource DoubleToText}}" />
                        <CheckBox Grid.Row="3" Grid.Column="5"
                                  IsChecked="{Binding Current.SprintPhaseAlign, Mode=TwoWay}"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center" />
                        <CheckBox Grid.Row="3" Grid.Column="6"
                                  IsChecked="{Binding Current.SprintAutoFreq, Mode=TwoWay}"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center" />
                        <TextBox Grid.Row="3" Grid.Column="7"
                                 Height="30" Margin="4"
                                 VerticalContentAlignment="Center"
                                 TextAlignment="Right"
                                 Text="{Binding Current.SprintFreqDevThreshold, Mode=TwoWay, Converter={StaticResource DoubleToText}}" />
                        <TextBlock Grid.Row="4" Grid.Column="0"
                                   Text="{DynamicResource M_zipline}"
                                   Style="{StaticResource FieldLabel}" />
                        <TextBox Grid.Row="4" Grid.Column="1"
                                 Height="30" Margin="4"
                                 VerticalContentAlignment="Center"
                                 TextAlignment="Right"
                                 Text="{Binding Current.ZiplineAmp, Mode=TwoWay, Converter={StaticResource DoubleToText}}"  />
                        <TextBox Grid.Row="4" Grid.Column="2"
                                 Height="30" Margin="4"
                                 VerticalContentAlignment="Center"
                                 TextAlignment="Right"
                                 Text="{Binding Current.ZiplineDown, Mode=TwoWay, Converter={StaticResource DoubleToText}}"  />
                        <TextBox Grid.Row="4" Grid.Column="3"
                                 Height="30" Margin="4"
                                 VerticalContentAlignment="Center"
                                 TextAlignment="Right"
                                 Text="{Binding Current.ZiplineFreq, Mode=TwoWay, Converter={StaticResource DoubleToText}}"  />
                        <TextBox Grid.Row="4" Grid.Column="4"
                                 Height="30" Margin="4"
                                 VerticalContentAlignment="Center"
                                 TextAlignment="Right"
                                 Text="{Binding Current.ZiplinePhaseOffset, Mode=TwoWay, Converter={StaticResource DoubleToText}}"  />
                        <CheckBox Grid.Row="4" Grid.Column="5"
                                  IsChecked="{Binding Current.ZiplinePhaseAlign, Mode=TwoWay}"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center" />
                        <CheckBox Grid.Row="4" Grid.Column="6"
                                  IsChecked="{Binding Current.ZiplineAutoFreq, Mode=TwoWay}"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center" />
                        <TextBox Grid.Row="4" Grid.Column="7"
                                 Height="30" Margin="4"
                                 VerticalContentAlignment="Center"
                                 TextAlignment="Right"
                                 Text="{Binding Current.ZiplineFreqDevThreshold, Mode=TwoWay, Converter={StaticResource DoubleToText}}"  />
                    </Grid>
                    </ScrollViewer>
                </StackPanel>
            </Border>

            <!-- Advanced -->
            <Border Style="{StaticResource CardStyle}"
                    IsEnabled="{Binding HasCurrent}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <TextBlock Text="{DynamicResource M_advanced}"
                                   Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="{DynamicResource M_usually_don_t_touch_axis_and_directi}"
                                   Style="{StaticResource SectionHintStyle}" />
                    </StackPanel>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="310" />
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="38" />
                            <RowDefinition Height="38" />
                            <RowDefinition Height="52" />
                            <RowDefinition Height="52" />
                            <RowDefinition Height="58" />
                            <RowDefinition Height="38" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0"
                                   Text="{DynamicResource M_axis}"
                                   Style="{StaticResource FieldLabel}" />
                        <ComboBox Grid.Row="0" Grid.Column="1"
                                  Height="30"
                                  SelectedIndex="{Binding Current.AxisIndex}">
                            <ComboBoxItem Content="{DynamicResource M_auto}" />
                            <ComboBoxItem Content="{DynamicResource M_x}" />
                            <ComboBoxItem Content="{DynamicResource M_y}" />
                            <ComboBoxItem Content="{DynamicResource M_z}" />
                        </ComboBox>

                        <TextBlock Grid.Row="1" Grid.Column="0"
                                   Text="{DynamicResource M_direction}"
                                   Style="{StaticResource FieldLabel}" />
                        <ComboBox Grid.Row="1" Grid.Column="1"
                                  Height="30"
                                  SelectedIndex="{Binding Current.SignIndex}">
                            <ComboBoxItem Content="{DynamicResource M_x_2}" />
                            <ComboBoxItem Content="{DynamicResource M_x_3}" />
                        </ComboBox>

                        <!-- Env attack tau -->
                        <StackPanel Grid.Row="2" Grid.Column="0"
                                    VerticalAlignment="Center"
                                    ToolTip="{DynamicResource M_env_attack_tau_smooths_amplitude_acr}">
                            <TextBlock Text="{DynamicResource M_transition_smoothing}"
                                       Style="{StaticResource AdvancedParamTitle}" />
                            <TextBlock Text="{DynamicResource M_higher_for_motions_to_motions_smooth}"
                                       Style="{StaticResource AdvancedParamHint}" />
                        </StackPanel>
                        <TextBox Grid.Row="2" Grid.Column="1"
                                 Height="30"
                                 VerticalAlignment="Center"
                                 VerticalContentAlignment="Center"
                                 TextAlignment="Right"
                                 ToolTip="{DynamicResource M_env_attack_tau}"
                                 Text="{Binding Current.EnvAttack, Mode=TwoWay, Converter={StaticResource DoubleToText}}" />

                        <!-- Env freq tau -->
                        <StackPanel Grid.Row="3" Grid.Column="0"
                                    VerticalAlignment="Center"
                                    ToolTip="{DynamicResource M_env_freq_tau_smooths_changes_in_moti}">
                            <TextBlock Text="{DynamicResource M_frequency_smoothing}"
                                       Style="{StaticResource AdvancedParamTitle}" />
                            <TextBlock Text="{DynamicResource M_higher_slower_frequency_changes_lowe}"
                                       Style="{StaticResource AdvancedParamHint}" />
                        </StackPanel>
                        <TextBox Grid.Row="3" Grid.Column="1"
                                 Height="30"
                                 VerticalAlignment="Center"
                                 VerticalContentAlignment="Center"
                                 TextAlignment="Right"
                                 ToolTip="{DynamicResource M_env_freq_tau}"
                                 Text="{Binding Current.EnvFreq, Mode=TwoWay, Converter={StaticResource DoubleToText}}" />

                        <!-- Env to-idle tau -->
                        <StackPanel Grid.Row="4" Grid.Column="0"
                                    VerticalAlignment="Center"
                                    ToolTip="{DynamicResource M_env_to_idle_tau_dedicated_stop_tail_}">
                            <TextBlock Text="{DynamicResource M_stop_smoothing}"
                                       Style="{StaticResource AdvancedParamTitle}" />
                            <TextBlock Text="{DynamicResource M_for_motions_to_stop_higher_gentler_s}"
                                       Style="{StaticResource AdvancedParamHint}" />
                        </StackPanel>
                        <TextBox Grid.Row="4" Grid.Column="1"
                                 Height="30"
                                 VerticalAlignment="Center"
                                 VerticalContentAlignment="Center"
                                 TextAlignment="Right"
                                 ToolTip="{DynamicResource M_env_to_idle_tau_clips_containing_quo}"
                                 Text="{Binding Current.EnvIdle, Mode=TwoWay, Converter={StaticResource DoubleToText}}" />

                        <TextBlock Grid.Row="5" Grid.Column="0"
                                   Text="{DynamicResource M_native_amplify}"
                                   Style="{StaticResource FieldLabel}" />
                        <TextBox Grid.Row="5" Grid.Column="1"
                                 Height="30"
                                 VerticalContentAlignment="Center"
                                 TextAlignment="Right"
                                 Text="{Binding Current.NativeFactor, Mode=TwoWay, Converter={StaticResource DoubleToText}}" />
                    </Grid>

                    <!-- Jump/Inertia tuning lives only on Main -> Advanced. -->
                    <Border Background="{StaticResource SoftFillBrush}"
                            BorderBrush="#DCE6EF"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="12"
                            Margin="0,16,0,0">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="{DynamicResource M_jump_inertia}"
                                           Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="{DynamicResource M_jump_inertia_hint}"
                                           Style="{StaticResource SectionHintStyle}" />
                            </StackPanel>
                            <CheckBox Content="{DynamicResource M_jump_enabled}"
                                      Foreground="Black"
                                      IsChecked="{Binding Current.JumpEnabled}" />
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="350" />
                                    <ColumnDefinition Width="230" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="52" />
                                    <RowDefinition Height="52" />
                                    <RowDefinition Height="52" />
                                    <RowDefinition Height="52" />
                                    <RowDefinition Height="52" />
                                    <RowDefinition Height="52" />
                                    <RowDefinition Height="52" />
                                    <RowDefinition Height="88" />
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="{DynamicResource M_jump_rising_target}" Style="{StaticResource AdvancedParamTitle}" />
                                    <TextBlock Text="{DynamicResource M_jump_rising_target_hint}" Style="{StaticResource AdvancedParamHint}" />
                                </StackPanel>
                                <Grid Grid.Row="0" Grid.Column="1" Width="110" HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="20" />
                                        <ColumnDefinition Width="90" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="−" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                    <TextBox Grid.Column="1" Height="30" Margin="4" VerticalContentAlignment="Center" TextAlignment="Right"
                                             Text="{Binding Current.JumpRisingMagnitude, Mode=TwoWay, Converter={StaticResource DoubleToText}}" />
                                </Grid>

                                <StackPanel Grid.Row="1" Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="{DynamicResource M_jump_apex_falling_target}" Style="{StaticResource AdvancedParamTitle}" />
                                    <TextBlock Text="{DynamicResource M_jump_apex_falling_target_hint}" Style="{StaticResource AdvancedParamHint}" />
                                </StackPanel>
                                <TextBox Grid.Row="1" Grid.Column="1" Width="110" Height="30" HorizontalAlignment="Left" VerticalAlignment="Center"
                                         VerticalContentAlignment="Center" TextAlignment="Right"
                                         Text="{Binding Current.JumpApexFallingTarget, Mode=TwoWay, Converter={StaticResource DoubleToText}}" />

                                <StackPanel Grid.Row="2" Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="{DynamicResource M_jump_acceleration_response}" Style="{StaticResource AdvancedParamTitle}" />
                                    <TextBlock Text="{DynamicResource M_jump_acceleration_response_hint}" Style="{StaticResource AdvancedParamHint}" />
                                </StackPanel>
                                <TextBox Grid.Row="2" Grid.Column="1" Width="110" Height="30" HorizontalAlignment="Left" VerticalAlignment="Center"
                                         VerticalContentAlignment="Center" TextAlignment="Right"
                                         Text="{Binding Current.JumpAccelerationResponse, Mode=TwoWay, Converter={StaticResource DoubleToText}}" />

                                <StackPanel Grid.Row="3" Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="{DynamicResource M_jump_natural_frequency}" Style="{StaticResource AdvancedParamTitle}" />
                                    <TextBlock Text="{DynamicResource M_jump_natural_frequency_hint}" Style="{StaticResource AdvancedParamHint}" />
                                </StackPanel>
                                <TextBox Grid.Row="3" Grid.Column="1" Width="110" Height="30" HorizontalAlignment="Left" VerticalAlignment="Center"
                                         VerticalContentAlignment="Center" TextAlignment="Right"
                                         Text="{Binding Current.JumpNaturalFrequency, Mode=TwoWay, Converter={StaticResource DoubleToText}}" />

                                <StackPanel Grid.Row="4" Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="{DynamicResource M_jump_damping_ratio}" Style="{StaticResource AdvancedParamTitle}" />
                                    <TextBlock Text="{DynamicResource M_jump_damping_ratio_hint}" Style="{StaticResource AdvancedParamHint}" />
                                </StackPanel>
                                <TextBox Grid.Row="4" Grid.Column="1" Width="110" Height="30" HorizontalAlignment="Left" VerticalAlignment="Center"
                                         VerticalContentAlignment="Center" TextAlignment="Right"
                                         Text="{Binding Current.JumpDampingRatio, Mode=TwoWay, Converter={StaticResource DoubleToText}}" />

                                <StackPanel Grid.Row="5" Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="{DynamicResource M_jump_landing_impulse_gain}" Style="{StaticResource AdvancedParamTitle}" />
                                    <TextBlock Text="{DynamicResource M_jump_landing_impulse_gain_hint}" Style="{StaticResource AdvancedParamHint}" />
                                </StackPanel>
                                <TextBox Grid.Row="5" Grid.Column="1" Width="110" Height="30" HorizontalAlignment="Left" VerticalAlignment="Center"
                                         VerticalContentAlignment="Center" TextAlignment="Right"
                                         Text="{Binding Current.JumpLandingImpulseGain, Mode=TwoWay, Converter={StaticResource DoubleToText}}" />

                                <StackPanel Grid.Row="6" Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="{DynamicResource M_jump_landing_shake_amplitude}" Style="{StaticResource AdvancedParamTitle}" />
                                    <TextBlock Text="{DynamicResource M_jump_landing_shake_amplitude_hint}" Style="{StaticResource AdvancedParamHint}" />
                                </StackPanel>
                                <TextBox Grid.Row="6" Grid.Column="1" Width="110" Height="30" HorizontalAlignment="Left" VerticalAlignment="Center"
                                         VerticalContentAlignment="Center" TextAlignment="Right"
                                         Text="{Binding Current.JumpAmplitude, Mode=TwoWay, Converter={StaticResource DoubleToText}}" />

                                <StackPanel Grid.Row="7" Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="{DynamicResource M_jump_shake_preset}" Style="{StaticResource AdvancedParamTitle}" />
                                    <TextBlock Text="{DynamicResource M_jump_shake_preset_hint}" Style="{StaticResource AdvancedParamHint}" />
                                </StackPanel>
                                <StackPanel Grid.Row="7" Grid.Column="1" VerticalAlignment="Center">
                                    <Slider Minimum="0" Maximum="4" TickFrequency="1"
                                            IsSnapToTickEnabled="True" TickPlacement="BottomRight"
                                            Value="{Binding Current.JumpShakePresetIndex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <UniformGrid Columns="5" Margin="4,0,4,0">
                                        <TextBlock Text="1" FontSize="8" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Left" />
                                        <TextBlock Text="2" FontSize="8" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" />
                                        <TextBlock Text="3" FontSize="8" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" />
                                        <TextBlock Text="4" FontSize="8" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" />
                                        <TextBlock Text="5" FontSize="8" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Right" />
                                    </UniformGrid>
                                    <TextBlock Text="{Binding Current.JumpShakePresetSummary}" FontSize="8"
                                               Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,3,0,0" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Apply -->
            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                <Button Content="{DynamicResource M_apply}"
                        Width="140"
                        Height="32"
                        Command="{Binding ApplyCommand}" />
                <TextBlock Text="{Binding ApplyMessage}"
                           VerticalAlignment="Center"
                           Margin="12,0,0,0"
                           Foreground="{StaticResource AccentBrush}" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
