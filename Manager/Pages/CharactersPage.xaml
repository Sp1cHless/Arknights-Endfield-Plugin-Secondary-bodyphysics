<Page x:Class="SecondaryMotion.Manager.Pages.CharactersPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="{DynamicResource C_characters}"
      Loaded="OnLoaded"
      Unloaded="OnUnloaded">

    <Page.Resources>
        <SolidColorBrush x:Key="CardBorderBrush" Color="#E4E7EB" />
        <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="MutedBrush" Color="#7A7A7A" />
        <SolidColorBrush x:Key="SoftFillBrush" Color="#F4F6F8" />

        <!-- Compact card -->
        <Style x:Key="CardStyle" TargetType="{x:Type Border}">
            <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="12" />
        </Style>

        <Style x:Key="CompactLabel" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="#222222" />
        </Style>

        <Style x:Key="SectionHintStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="9" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="8,1,0,0" />
        </Style>

        <Style x:Key="AdvancedParamTitle" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#222222" />
        </Style>

        <Style x:Key="AdvancedParamHint" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="8" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,1,6,0" />
        </Style>

        <!-- Simple list item: no accent strip -->
        <Style x:Key="CharacterListItemStyle" TargetType="{x:Type ListBoxItem}">
            <Setter Property="Foreground" Value="#1B1B1B" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListBoxItem}">
                        <Border x:Name="ItemBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#F2F4F7" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#EAF2FA" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid Background="#FAFAFB" Margin="14,12,18,14">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Character list -->
        <Border Grid.Column="0"
                Style="{StaticResource CardStyle}">
            <DockPanel>
                <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{DynamicResource C_characters}"
                                   FontSize="18"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="{DynamicResource C_select_a_character_to_edit}"
                                   Foreground="{StaticResource MutedBrush}"
                                   FontSize="9"
                                   Margin="0,2,0,0" />
                    </StackPanel>

                    <Button Grid.Column="1"
                            Content="{DynamicResource C_refresh}"
                            MinWidth="62"
                            Height="26"
                            FontSize="10"
                            Margin="8,0,0,0"
                            Command="{Binding RefreshCommand}" />
                </Grid>

                <ListBox ItemsSource="{Binding Items}"
                         SelectedItem="{Binding Selected}"
                         DisplayMemberPath="Display"
                         BorderThickness="0"
                         Background="Transparent"
                         ItemContainerStyle="{StaticResource CharacterListItemStyle}" />
            </DockPanel>
        </Border>

        <!-- Editor -->
        <ScrollViewer Grid.Column="2"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel MaxWidth="570"
                        HorizontalAlignment="Left">

                <TextBlock Text="{Binding Selected.Display,
                                          TargetNullValue=Select a character,
                                          FallbackValue=Select a character}"
                           FontSize="20"
                           FontWeight="SemiBold" />
                <TextBlock Text="{DynamicResource C_character_specific_motion_settings}"
                           Foreground="{StaticResource MutedBrush}"
                           FontSize="9"
                           Margin="0,2,0,0" />

                <!-- Basic -->
                <Border Style="{StaticResource CardStyle}"
                        Margin="0,8,0,0"
                        IsEnabled="{Binding HasSelection}">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource C_basic}"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,8" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="125" />
                                <ColumnDefinition Width="195" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="31" />
                                <RowDefinition Height="31" />
                                <RowDefinition Height="31" />
                                <RowDefinition Height="31" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0"
                                       Text="{DynamicResource C_display_name}"
                                       Style="{StaticResource CompactLabel}" />
                            <TextBox Grid.Row="0" Grid.Column="1"
                                     Height="26"
                                     FontSize="10"
                                     VerticalContentAlignment="Center"
                                     Text="{Binding Selected.DisplayName,
                                                    Mode=TwoWay,
                                                    UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock Grid.Row="1" Grid.Column="0"
                                       Text="{DynamicResource C_enabled}"
                                       Style="{StaticResource CompactLabel}" />
                            <CheckBox Grid.Row="1" Grid.Column="1"
                                      VerticalAlignment="Center"
                                      IsChecked="{Binding Selected.Enabled}" />

                            <TextBlock Grid.Row="2" Grid.Column="0"
                                       Text="{DynamicResource C_mode}"
                                       Style="{StaticResource CompactLabel}" />
                            <ComboBox Grid.Row="2" Grid.Column="1"
                                      Height="26"
                                      FontSize="10"
                                      SelectedIndex="{Binding Selected.ModeIndex}">
                                <ComboBoxItem Content="{DynamicResource C_original_off}" />
                                <ComboBoxItem Content="{DynamicResource C_synthetic}" />
                                <ComboBoxItem Content="{DynamicResource C_amplify_native}" />
                            </ComboBox>

                            <TextBlock Grid.Row="3" Grid.Column="0"
                                       Text="{DynamicResource C_id_dev}"
                                       Style="{StaticResource CompactLabel}" />
                            <Border Grid.Row="3" Grid.Column="1"
                                    Background="{StaticResource SoftFillBrush}"
                                    CornerRadius="4"
                                    Padding="7,3">
                                <TextBlock Text="{Binding Selected.Data.Id}"
                                           Foreground="{StaticResource MutedBrush}"
                                           FontSize="10"
                                           VerticalAlignment="Center" />
                            </Border>

                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Gait -->
                <Border Style="{StaticResource CardStyle}"
                        Margin="0,8,0,0"
                        IsEnabled="{Binding HasSelection}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock Text="{DynamicResource C_gait}"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource AccentBrush}" />
                            <TextBlock Text="{DynamicResource C_edit_motion_data}"
                                       Style="{StaticResource SectionHintStyle}" />
                        </StackPanel>

                        <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Disabled">
                        <Grid HorizontalAlignment="Left">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="52" />
                                <ColumnDefinition Width="85" />
                                <ColumnDefinition Width="85" />
                                <ColumnDefinition Width="85" />
                                <ColumnDefinition Width="85" />
                                <ColumnDefinition Width="48" />
                                <ColumnDefinition Width="48" />
                                <ColumnDefinition Width="55" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="22" />
                                <RowDefinition Height="32" />
                                <RowDefinition Height="32" />
                                <RowDefinition Height="32" />
                                <RowDefinition Height="32" />
</Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="1"
                                       Text="{DynamicResource C_up_degree}"
                                       Foreground="{StaticResource MutedBrush}"
                                       FontSize="9"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                            <TextBlock Grid.Row="0" Grid.Column="2"
                                       Text="{DynamicResource C_down_degree}"
                                       Foreground="{StaticResource MutedBrush}"
                                       FontSize="9"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                            <TextBlock Grid.Row="0" Grid.Column="3"
                                       Text="{DynamicResource C_frequency_hz}"
                                       Foreground="{StaticResource MutedBrush}"
                                       FontSize="9"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                            <TextBlock Grid.Row="0" Grid.Column="4"
                                       Text="{DynamicResource C_phase_offset_deg}"
                                       Foreground="{StaticResource MutedBrush}"
                                       FontSize="9"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                            <TextBlock Grid.Row="0" Grid.Column="5"
                                       Text="{DynamicResource C_phase_align}"
                                       Foreground="{StaticResource MutedBrush}"
                                       FontSize="9"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                            <TextBlock Grid.Row="0" Grid.Column="6"
                                       Text="{DynamicResource C_auto_freq}"
                                       Foreground="{StaticResource MutedBrush}"
                                       FontSize="9"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                            <TextBlock Grid.Row="0" Grid.Column="7"
                                       Text="{DynamicResource C_freq_dev_threshold}"
                                       Foreground="{StaticResource MutedBrush}"
                                       FontSize="9"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />

                            <TextBlock Grid.Row="1" Grid.Column="0"
                                       Text="{DynamicResource C_walk}"
                                       Style="{StaticResource CompactLabel}" />
                            <TextBox Grid.Row="1" Grid.Column="1"
                                     Height="26" Margin="3"
                                     FontSize="10"
                                     VerticalContentAlignment="Center"
                                     TextAlignment="Right"
                                     Text="{Binding Selected.WalkAmp, Mode=TwoWay, Converter={StaticResource DoubleToText}}" />
                            <TextBox Grid.Row="1" Grid.Column="2"
                                     Height="26" Margin="3"
                                     FontSize="10"
                                     VerticalContentAlignment="Center"
                                     TextAlignment="Right"
                                     Text="{Binding Selected.WalkDown, Mode=TwoWay, Converter={StaticResource DoubleToText}}" />
                            <TextBox Grid.Row="1" Grid.Column="3"
                                     Height="26" Margin="3"
                                     FontSize="10"
                                     VerticalContentAlignment="Center"
                                     TextAlignment="Right"
                                     Text="{Binding Selected.WalkFreq, Mode=TwoWay, Converter={StaticResource DoubleToText}}" />
                            <TextBox Grid.Row="1" Grid.Column="4"
                                     Height="26" Margin="3"
                                     FontSize="10"
                                     VerticalContentAlignment="Center"
                                     TextAlignment="Right"
                                     Text="{Binding Selected.WalkPhaseOffset, Mode=TwoWay, Converter={StaticResource DoubleToText}}" />
                            <CheckBox Grid.Row="1" Grid.Column="5"
                                      IsChecked="{Binding Selected.WalkPhaseAlign, Mode=TwoWay}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center" />
                            <CheckBox Grid.Row="1" Grid.Column="6"
                                      IsChecked="{Binding Selected.WalkAutoFreq, Mode=TwoWay}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center" />
                            <TextBox Grid.Row="1" Grid.Column="7"
                                     Height="26" Margin="3"
                                     FontSize="10"
                                     VerticalContentAlignment="Center"
                                     TextAlignment="Right"
                                     Text="{Binding Selected.WalkFreqDevThreshold, Mode=TwoWay, Converter={StaticResource DoubleToText}}" />

                            <TextBlock Grid.Row="2" Grid.Column="0"
                                       Text="{DynamicResource C_run}"
                                       Style="{StaticResource CompactLabel}" />
                            <TextBox Grid.Row="2" Grid.Column="1"
                                     Height="26" Margin="3"
                                     FontSize="10"
                                     VerticalContentAlignment="Center"
                                     TextAlignment="Right"
                                     Text="{Binding Selected.RunAmp, Mode=TwoWay, Converter={StaticResource DoubleToText}}" />
                            <TextBox Grid.Row="2" Grid.Column="2"
                                     Height="26" Margin="3"
                                     FontSize="10"
                                     VerticalContentAlignment="Center"
                                     TextAlignment="Right"
                                     Text="{Binding Selected.RunDown, Mode=TwoWay, Converter={StaticResource DoubleToText}}" />
                            <TextBox Grid.Row="2" Grid.Column="3"
                                     Height="26" Margin="3"
                                     FontSize="10"
                                     VerticalContentAlignment="Center"
                                     TextAlignment="Right"
                                     Text="{Binding Selected.RunFreq, Mode=TwoWay, Converter={StaticResource DoubleToText}}" />
                            <TextBox Grid.Row="2" Grid.Column="4"
                                     Height="26" Margin="3"
                                     FontSize="10"
                                     VerticalContentAlignment="Center"
                                     TextAlignment="Right"
                                     Text="{Binding Selected.RunPhaseOffset, Mode=TwoWay, Converter={StaticResource DoubleToText}}" />
                            <CheckBox Grid.Row="2" Grid.Column="5"
                                      IsChecked="{Binding Selected.RunPhaseAlign, Mode=TwoWay}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center" />
                            <CheckBox Grid.Row="2" Grid.Column="6"
                                      IsChecked="{Binding Selected.RunAutoFreq, Mode=TwoWay}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center" />
                            <TextBox Grid.Row="2" Grid.Column="7"
                                     Height="26" Margin="3"
                                     FontSize="10"
                                     VerticalContentAlignment="Center"
                                     TextAlignment="Right"
                                     Text="{Binding Selected.RunFreqDevThreshold, Mode=TwoWay, Converter={StaticResource DoubleToText}}" />

                            <TextBlock Grid.Row="3" Grid.Column="0"
                                       Text="{DynamicResource C_sprint}"
                                       Style="{StaticResource CompactLabel}" />
                            <TextBox Grid.Row="3" Grid.Column="1"
                                     Height="26" Margin="3"
                                     FontSize="10"
                                     VerticalContentAlignment="Center"
                                     TextAlignment="Right"
                                     Text="{Binding Selected.SprintAmp, Mode=TwoWay, Converter={StaticResource DoubleToText}}" />
                            <TextBox Grid.Row="3" Grid.Column="2"
                                     Height="26" Margin="3"
                                     FontSize="10"
                                     VerticalContentAlignment="Center"
                                     TextAlignment="Right"
                                     Text="{Binding Selected.SprintDown, Mode=TwoWay, Converter={StaticResource DoubleToText}}" />
                            <TextBox Grid.Row="3" Grid.Column="3"
                                     Height="26" Margin="3"
                                     FontSize="10"
                                     VerticalContentAlignment="Center"
                                     TextAlignment="Right"
                                     Text="{Binding Selected.SprintFreq, Mode=TwoWay, Converter={StaticResource DoubleToText}}" />
                            <TextBox Grid.Row="3" Grid.Column="4"
                                     Height="26" Margin="3"
                                     FontSize="10"
                                     VerticalContentAlignment="Center"
                                     TextAlignment="Right"
                                     Text="{Binding Selected.SprintPhaseOffset, Mode=TwoWay, Converter={StaticResource DoubleToText}}" />
                            <CheckBox Grid.Row="3" Grid.Column="5"
                                      IsChecked="{Binding Selected.SprintPhaseAlign, Mode=TwoWay}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center" />
                            <CheckBox Grid.Row="3" Grid.Column="6"
                                      IsChecked="{Binding Selected.SprintAutoFreq, Mode=TwoWay}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center" />
                            <TextBox Grid.Row="3" Grid.Column="7"
                                     Height="26" Margin="3"
                                     FontSize="10"
                                     VerticalContentAlignment="Center"
                                     TextAlignment="Right"
                                     Text="{Binding Selected.SprintFreqDevThreshold, Mode=TwoWay, Converter={StaticResource DoubleToText}}" />
                            <TextBlock Grid.Row="4" Grid.Column="0"
                                       Text="{DynamicResource C_zipline}"
                                       Style="{StaticResource CompactLabel}" />
                        <TextBox Grid.Row="4" Grid.Column="1"
                                     Height="26" Margin="3"
                                     FontSize="10"
                                     VerticalContentAlignment="Center"
                                     TextAlignment="Right"
                                     Text="{Binding Selected.ZiplineAmp, Mode=TwoWay, Converter={StaticResource DoubleToText}}"  />
                        <TextBox Grid.Row="4" Grid.Column="2"
                                     Height="26" Margin="3"
                                     FontSize="10"
                                     VerticalContentAlignment="Center"
                                     TextAlignment="Right"
                                     Text="{Binding Selected.ZiplineDown, Mode=TwoWay, Converter={StaticResource DoubleToText}}"  />
                        <TextBox Grid.Row="4" Grid.Column="3"
                                     Height="26" Margin="3"
                                     FontSize="10"
                                     VerticalContentAlignment="Center"
                                     TextAlignment="Right"
                                     Text="{Binding Selected.ZiplineFreq, Mode=TwoWay, Converter={StaticResource DoubleToText}}"  />
                        <TextBox Grid.Row="4" Grid.Column="4"
                                     Height="26" Margin="3"
                                     FontSize="10"
                                     VerticalContentAlignment="Center"
                                     TextAlignment="Right"
                                     Text="{Binding Selected.ZiplinePhaseOffset, Mode=TwoWay, Converter={StaticResource DoubleToText}}"  />
                            <CheckBox Grid.Row="4" Grid.Column="5"
                                      IsChecked="{Binding Selected.ZiplinePhaseAlign, Mode=TwoWay}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center" />
                            <CheckBox Grid.Row="4" Grid.Column="6"
                                      IsChecked="{Binding Selected.ZiplineAutoFreq, Mode=TwoWay}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center" />
                            <TextBox Grid.Row="4" Grid.Column="7"
                                     Height="26" Margin="3"
                                     FontSize="10"
                                     VerticalContentAlignment="Center"
                                     TextAlignment="Right"
                                     Text="{Binding Selected.ZiplineFreqDevThreshold, Mode=TwoWay, Converter={StaticResource DoubleToText}}"  />
                        </Grid>
                        </ScrollViewer>
                    </StackPanel>
                </Border>

                <!-- Advanced -->
                <Border Style="{StaticResource CardStyle}"
                        Margin="0,8,0,0"
                        IsEnabled="{Binding HasSelection}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,7">
                            <TextBlock Text="{DynamicResource C_advanced}"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource AccentBrush}" />
                            <TextBlock Text="{DynamicResource C_usually_don_t_touch}"
                                       Style="{StaticResource SectionHintStyle}" />
                        </StackPanel>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="275" />
                                <ColumnDefinition Width="155" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="31" />
                                <RowDefinition Height="31" />
                                <RowDefinition Height="44" />
                                <RowDefinition Height="44" />
                                <RowDefinition Height="50" />
                                <RowDefinition Height="31" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0"
                                       Text="{DynamicResource C_axis}"
                                       Style="{StaticResource CompactLabel}" />
                            <ComboBox Grid.Row="0" Grid.Column="1"
                                      Height="26"
                                      FontSize="10"
                                      SelectedIndex="{Binding Selected.AxisIndex}">
                                <ComboBoxItem Content="{DynamicResource C_auto}" />
                                <ComboBoxItem Content="{DynamicResource C_x}" />
                                <ComboBoxItem Content="{DynamicResource C_y}" />
                                <ComboBoxItem Content="{DynamicResource C_z}" />
                            </ComboBox>

                            <TextBlock Grid.Row="1" Grid.Column="0"
                                       Text="{DynamicResource C_direction}"
                                       Style="{StaticResource CompactLabel}" />
                            <ComboBox Grid.Row="1" Grid.Column="1"
                                      Height="26"
                                      FontSize="10"
                                      SelectedIndex="{Binding Selected.SignIndex}">
                                <ComboBoxItem Content="{DynamicResource C_x_2}" />
                                <ComboBoxItem Content="{DynamicResource C_x_3}" />
                            </ComboBox>

                            <!-- Env attack tau -->
                            <StackPanel Grid.Row="2" Grid.Column="0"
                                        VerticalAlignment="Center"
                                        ToolTip="{DynamicResource C_env_attack_tau_smooths_amplitude_acr}">
                                <TextBlock Text="{DynamicResource C_transition_smoothing}"
                                           Style="{StaticResource AdvancedParamTitle}" />
                                <TextBlock Text="{DynamicResource C_higher_smoother_transitions_lower_mo}"
                                           Style="{StaticResource AdvancedParamHint}" />
                            </StackPanel>
                            <TextBox Grid.Row="2" Grid.Column="1"
                                     Height="26"
                                     FontSize="10"
                                     VerticalAlignment="Center"
                                     VerticalContentAlignment="Center"
                                     TextAlignment="Right"
                                     ToolTip="{DynamicResource C_env_attack_tau}"
                                     Text="{Binding Selected.EnvAttack, Mode=TwoWay, Converter={StaticResource DoubleToText}}" />

                            <!-- Env freq tau -->
                            <StackPanel Grid.Row="3" Grid.Column="0"
                                        VerticalAlignment="Center"
                                        ToolTip="{DynamicResource C_env_freq_tau_smooths_changes_in_moti}">
                                <TextBlock Text="{DynamicResource C_frequency_smoothing}"
                                           Style="{StaticResource AdvancedParamTitle}" />
                                <TextBlock Text="{DynamicResource C_higher_slower_frequency_changes_lowe}"
                                           Style="{StaticResource AdvancedParamHint}" />
                            </StackPanel>
                            <TextBox Grid.Row="3" Grid.Column="1"
                                     Height="26"
                                     FontSize="10"
                                     VerticalAlignment="Center"
                                     VerticalContentAlignment="Center"
                                     TextAlignment="Right"
                                     ToolTip="{DynamicResource C_env_freq_tau}"
                                     Text="{Binding Selected.EnvFreq, Mode=TwoWay, Converter={StaticResource DoubleToText}}" />

                            <!-- Env to-idle tau -->
                            <StackPanel Grid.Row="4" Grid.Column="0"
                                        VerticalAlignment="Center"
                                        ToolTip="{DynamicResource C_env_to_idle_tau_dedicated_stop_tail_}">
                                <TextBlock Text="{DynamicResource C_stop_smoothing}"
                                           Style="{StaticResource AdvancedParamTitle}" />
                                <TextBlock Text="{DynamicResource C_stop_to_idle_only_higher_gentler_sto}"
                                           Style="{StaticResource AdvancedParamHint}" />
                            </StackPanel>
                            <TextBox Grid.Row="4" Grid.Column="1"
                                     Height="26"
                                     FontSize="10"
                                     VerticalAlignment="Center"
                                     VerticalContentAlignment="Center"
                                     TextAlignment="Right"
                                     ToolTip="{DynamicResource C_env_to_idle_tau_clips_containing_quo}"
                                     Text="{Binding Selected.EnvIdle, Mode=TwoWay, Converter={StaticResource DoubleToText}}" />

                            <TextBlock Grid.Row="5" Grid.Column="0"
                                       Text="{DynamicResource C_native_amplify}"
                                       Style="{StaticResource CompactLabel}" />
                            <TextBox Grid.Row="5" Grid.Column="1"
                                     Height="26"
                                     FontSize="10"
                                     VerticalContentAlignment="Center"
                                     TextAlignment="Right"
                                     Text="{Binding Selected.NativeFactor, Mode=TwoWay, Converter={StaticResource DoubleToText}}" />
                        </Grid>

                    </StackPanel>
                </Border>

                <!-- Actions -->
                <StackPanel Orientation="Horizontal"
                            Margin="0,10,0,2"
                            IsEnabled="{Binding HasSelection}">
                    <Button Content="{DynamicResource C_apply}"
                            Width="108"
                            Height="28"
                            FontSize="10"
                            Command="{Binding ApplyCommand}" />
                    <Button Content="{DynamicResource C_delete_from_preset}"
                            Width="126"
                            Height="28"
                            FontSize="10"
                            Margin="7,0,0,0"
                            Command="{Binding DeleteCommand}" />
                    <TextBlock Text="{Binding ApplyMessage}"
                               VerticalAlignment="Center"
                               FontSize="10"
                               Margin="10,0,0,0"
                               Foreground="{StaticResource AccentBrush}" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
